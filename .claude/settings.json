{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__supabase__execute_sql|mcp__supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guardian-bd.js"],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Guardián BD: revisando SQL..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/calidad-codigo.js"],
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Calidad de código: ejecutando oxlint..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bitacora-prompts.js"],
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
